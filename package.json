{
  "name": "snow-app",
  "version": "0.1.22",
  "description": "Snow App The best AI Agent client in the universe",
  "author": {
    "name": "MayDay",
    "email": "mufasa@snow.app"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev 2>&1 | node scripts/filter-ime-noise.cjs",
    "build": "npm run build:rust && tsc --noEmit && electron-vite build",
    "build:app": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win nsis portable",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac dmg zip --x64",
    "build:mac:universal": "npm run build && electron-builder --mac dmg zip --universal",
    "update:manifest": "node scripts/generate-latest-json.cjs",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:all": "npm run build && electron-builder -mwl",
    "build:rust": "node scripts/build-native.cjs",
    "build:snow-agent-release": "node scripts/build-snow-agent-release.cjs",
    "verify:snow-agent-release": "node scripts/verify-snow-agent-release.cjs",
    "postinstall": "node scripts/patch-spectre.cjs && node scripts/ensure-conpty-dll.cjs",
    "check": "npm run check:ts && cargo check --manifest-path native/Cargo.toml",
    "check:ts": "tsc --noEmit",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@iarna/toml": "^2.2.5",
    "@napi-rs/triples": "^1.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "motion": "12.43.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0",
    "react-simple-code-editor": "^0.14.1",
    "ssh2": "^1.17.0",
    "streaming-markdown": "^0.2.15",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.5",
    "@types/highlight.js": "^9.12.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.snow.app",
    "productName": "Snow App",
    "asar": true,
    "files": [
      "out/**",
      "native/*.node",
      "native/index.cjs",
      "package.json",
      "!native/snow_native.*.*.node",
      "!**/node_modules/node-pty/build/deps/**",
      "!**/node_modules/node-pty/build/Release/*.iobj",
      "!**/node_modules/node-pty/build/Release/*.ipdb",
      "!**/node_modules/node-pty/build/Release/*.lib",
      "!**/node_modules/node-pty/build/Release/*.exp",
      "!**/node_modules/node-pty/build/Release/*.tlog",
      "!**/node_modules/node-pty/build/Release/*.recipe",
      "!**/node_modules/node-pty/build/Release/*.lastbuildstate",
      "!**/node_modules/node-pty/build/Release/*.xml",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/third_party/conpty/**/win10-arm64/**",
      "resources/skills/**",
      "docs/**"
    ],
    "asarUnpack": [
      "native/*.node",
      "node_modules/node-pty/**",
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/web",
        "to": "web"
      },
      {
        "from": "resources/snow-agent/trust.json",
        "to": "snow-agent/trust.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "MayDay-wpf",
      "repo": "snow-app"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Snow-App-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "Snow-App-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Snow App",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Snow-App-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "maintainer": "MayDay <mufasa@snow.app>"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
